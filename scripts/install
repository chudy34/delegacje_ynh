#!/bin/bash

# Exit on error
set -e

# 1. Load YunoHost helpers FIRST
source /usr/share/yunohost/helpers

# 2. Load app specific variables
app=$YNH_APP_INSTANCE_NAME
source _common.sh

# 3. Load settings from YunoHost database
load_app_settings
validate_paths

# 4. Install dependencies (Node.js 20)
if ! [ -f /etc/apt/sources.list.d/nodesource.list ]; then
    ynh_print_info --message="Adding NodeSource repository..."
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
fi
ynh_package_install nodejs

# 5. Create directories and set permissions
mkdir -p "$install_dir"
mkdir -p "$data_dir/uploads"
mkdir -p "$data_dir/logs"

# Ensure we don't chown empty string
chown -R "$app:$app" "$install_dir"
chown -R "$app:$app" "$data_dir"

# 6. Download source code (from main app repo)
ynh_print_info --message="Downloading source code..."
# Here we would normally use ynh_setup_source, but for now we assume files are in place
# or we fetch them from the main Delegacje repo.

# 7. Configure Backend & Frontend
# [Dalsza część konfiguracji env, npm install, prisma migrate...]

ynh_print_info --message="Installation completed successfully!"
