#!/bin/bash
set -eu

source _common.sh
source /usr/share/yunohost/helpers

# Zmienne z formularza instalacji
admin_email=$YNH_APP_ARG_ADMIN_EMAIL
admin_password=$YNH_APP_ARG_ADMIN_PASSWORD
openai_api_key=${YNH_APP_ARG_OPENAI_API_KEY:-}

# ── Generate app secrets ──────────────────────────────────────────────────
ynh_print_info --message="Generating secrets..."
jwt_secret=$(openssl rand -base64 48)
encryption_key=$(openssl rand -base64 32)
ynh_app_setting_set --app="$app" --key=jwt_secret    --value="$jwt_secret"
ynh_app_setting_set --app="$app" --key=encryption_key --value="$encryption_key"
ynh_app_setting_set --app="$app" --key=ai_provider    --value="$ai_provider"
ynh_app_setting_set --app="$app" --key=gemini_api_key --value="$gemini_api_key"
ynh_app_setting_set --app="$app" --key=openai_api_key --value="$openai_api_key"

# ── Clone source ──────────────────────────────────────────────────────────
ynh_print_info --message="Cloning source code from GitHub..."
ynh_exec_warn_less git clone --depth=1 https://github.com/chudy34/Delegacje /tmp/${app}-src

# ── Copy into install_dir ─────────────────────────────────────────────────
ynh_print_info --message="Copying files..."
mkdir -p "$install_dir/backend" "$install_dir/frontend"
cp -r /tmp/${app}-src/backend/. "$install_dir/backend/"
cp -r /tmp/${app}-src/frontend/. "$install_dir/frontend/"
rm -rf /tmp/${app}-src

chown -R "$app:$app" "$install_dir" "$data_dir"

# ── Backend .env ──────────────────────────────────────────────────────────
cat > "$install_dir/backend/.env" << EOF
NODE_ENV=production
PORT=${port_backend}
DATABASE_URL=postgresql://${db_user}:${db_pwd}@localhost:5432/${db_name}
JWT_SECRET=${jwt_secret}
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=${encryption_key}
CORS_ORIGIN=https://${domain}
UPLOAD_DIR=${data_dir}/uploads
LOG_DIR=${data_dir}/logs
AI_PROVIDER=${ai_provider}
GEMINI_API_KEY=${gemini_api_key}
OPENAI_API_KEY=${openai_api_key}
EOF

# ── Frontend .env.production ──────────────────────────────────────────────
# NEXT_PUBLIC_API_URL wskazuje na wewnętrzny backend – używany przez Next.js
# rewrite proxy (server-side). Nginx na produkcji przechwytuje /api/ osobnym blokiem.
cat > "$install_dir/frontend/.env.production" << EOF
NEXT_PUBLIC_API_URL=http://127.0.0.1:${port_backend}
PORT=${port_frontend}
NODE_ENV=production
EOF

chown "$app:$app" "$install_dir/backend/.env" "$install_dir/frontend/.env.production"

# ── Build backend ─────────────────────────────────────────────────────────
ynh_print_info --message="Building backend (npm ci + tsc + prisma)..."
pushd "$install_dir/backend"
    ynh_exec_as "$app" npm ci
    ynh_exec_as "$app" npx prisma generate
    ynh_exec_as "$app" npm run build
    ynh_exec_as "$app" npx prisma migrate deploy
popd

# ── Build frontend ────────────────────────────────────────────────────────
ynh_print_info --message="Building frontend (Next.js standalone)..."
pushd "$install_dir/frontend"
    ynh_exec_as "$app" npm ci
    ynh_exec_as "$app" npm run build
popd

# ── Copy Next.js standalone static assets ────────────────────────────────
STANDALONE_DIR="$install_dir/frontend/.next/standalone"
if [ ! -d "$STANDALONE_DIR" ]; then
    ynh_die --message="Next.js standalone build not found. Upewnij się że next.config.js ma output: 'standalone'."
fi
cp -r "$install_dir/frontend/.next/static"  "$STANDALONE_DIR/.next/static"
cp -r "$install_dir/frontend/public"        "$STANDALONE_DIR/public" 2>/dev/null || true

chown -R "$app:$app" "$install_dir"

# ── Nginx ─────────────────────────────────────────────────────────────────
ynh_add_nginx_config

# ── Systemd services ──────────────────────────────────────────────────────
ynh_add_systemd_config --service="${app}-backend"  --template="backend.service"
ynh_add_systemd_config --service="${app}-frontend" --template="frontend.service"
systemctl daemon-reload

# ── Start services ────────────────────────────────────────────────────────
ynh_print_info --message="Starting backend..."
ynh_systemd_action --service_name="${app}-backend"  --action=start \
    --log_path="$data_dir/logs/backend.log" --timeout=60

ynh_print_info --message="Starting frontend..."
ynh_systemd_action --service_name="${app}-frontend" --action=start \
    --log_path="$data_dir/logs/frontend.log" --timeout=60

# ── Create initial admin account ──────────────────────────────────────────
ynh_print_info --message="Creating admin account..."
sleep 5
for i in $(seq 1 12); do
    http_code=$(curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:${port_backend}/health" || echo "000")
    if [ "$http_code" = "200" ]; then
        break
    fi
    ynh_print_info --message="Waiting for backend... (${i}/12)"
    sleep 5
done

curl -s -X POST "http://127.0.0.1:${port_backend}/api/v1/auth/register" \
    -H "Content-Type: application/json" \
    -d "{\"email\":\"${admin_email}\",\"password\":\"${admin_password}\",\"firstName\":\"Admin\",\"lastName\":\"${admin}\"}" \
    && ynh_print_info --message="Admin account created: ${admin_email}" \
    || ynh_print_warn --message="Could not create admin account automatically. Zarejestruj się ręcznie na https://${domain}/auth/register"

ynh_print_info --message="Instalacja zakończona! Aplikacja dostępna pod: https://${domain}"
